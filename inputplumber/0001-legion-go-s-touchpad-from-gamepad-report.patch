From e433ef920afd8ad876321c90dbb414cd1f5b7d3d Mon Sep 17 00:00:00 2001
From: selfxplanatorium <110287336+selfxplanatorium@users.noreply.github.com>
Date: Wed, 4 Nov 2026 00:45:16 +0100
Subject: [PATCH] fix(Legion Go S): read touchpad input from the gamepad report

On my Legion Go S (83L3, controller firmware 0.0.4.3, SIPO touchpad
firmware v12) the touchpad does nothing under InputPlumber. IF2 does send
report 0x31 while a finger is on the pad, but every report is the same:
x=400, y=256, scan time 8, tip switch and buttons 0. Since nothing ever
changes, the touchpad driver never emits an event.

The live data shows up in the gamepad report on IF6 instead. Byte 8 bit 0
is set while a finger is down, byte 9 bit 0 is set on click, and bytes 10
and 11 carry signed X/Y movement for each report. XInputDataReport already
defines these fields (rpad_touching, rpad_tap, touch_x, touch_y), but the
driver doesn't read them.

This translates them into right touchpad events. A touch starts at the pad
center and the deltas move the position within 0..=PAD_MOTION_MAX. The
click bit drives RPadPress along with the simulated pad force the deck
target needs to register a click. The gamepad source now advertises the
touchpad motion, press and force capabilities so the composite device
routes them.

Units where the IF2 report works could get input from both paths, so
INPUTPLUMBER_LEGION_GO_S_GAMEPAD_TOUCHPAD=0 turns this one off.
INPUTPLUMBER_LEGION_GO_S_GAMEPAD_TOUCHPAD_GAIN scales the deltas
(default 1.0).

Tested on SteamOS 3.9.5 with the deck target. Touchpad movement and clicks
work in Steam.

Claude helped trace the problem (raw HID captures and decoding the report
descriptor) and wrote the code in this commit. I reviewed the change and
tested it by hand on my device.

Co-developed-by: Claude Opus 5.5
---
 src/drivers/legion_go_s/xinput_driver.rs      | 94 ++++++++++++++++++-
 src/input/source/hidraw/legion_go_s/xinput.rs |  8 +-
 2 files changed, 98 insertions(+), 4 deletions(-)

diff --git a/src/drivers/legion_go_s/xinput_driver.rs b/src/drivers/legion_go_s/xinput_driver.rs
index 5e3e80a..9804e58 100644
--- a/src/drivers/legion_go_s/xinput_driver.rs
+++ b/src/drivers/legion_go_s/xinput_driver.rs
@@ -5,13 +5,18 @@ use packed_struct::PackedStruct;
 
 use super::{
     event::{
-        AxisEvent, BinaryInput, ButtonEvent, Event, JoyAxisInput, OutputEvent, TriggerEvent,
-        TriggerInput,
+        AxisEvent, BinaryInput, ButtonEvent, Event, JoyAxisInput, OutputEvent, TouchAxisInput,
+        TriggerEvent, TriggerInput,
     },
     hid_report::{RumbleOutputDataReport, XInputDataReport},
-    GAMEPAD_TIMEOUT, GP_IID, PIDS, VID, XINPUT_PACKET_SIZE,
+    GAMEPAD_TIMEOUT, GP_IID, PAD_FORCE_NORMAL, PAD_MOTION_MAX, PIDS, VID, XINPUT_PACKET_SIZE,
 };
 
+/// Environment variable that disables the gamepad-report touchpad path ("0").
+const GAMEPAD_TOUCHPAD_ENV: &str = "INPUTPLUMBER_LEGION_GO_S_GAMEPAD_TOUCHPAD";
+/// Environment variable with a multiplier for the touchpad deltas (default 1.0).
+const GAMEPAD_TOUCHPAD_GAIN_ENV: &str = "INPUTPLUMBER_LEGION_GO_S_GAMEPAD_TOUCHPAD_GAIN";
+
 pub struct XInputDriver {
     /// HIDRAW device instance
     device: HidDevice,
@@ -19,6 +24,16 @@ pub struct XInputDriver {
     xinput_state: Option<XInputDataReport>,
 
     filtered_events: Vec<Event>,
+
+    /// Whether touchpad data from the gamepad report is translated.
+    /// On some SIPO touchpad firmware the touchpad interface (IF2) only
+    /// repeats a frozen absolute frame, while the gamepad report carries live
+    /// touch, tap and relative motion data in bytes 8-11.
+    pad_enabled: bool,
+    /// Multiplier applied to the relative touchpad deltas.
+    pad_gain: f64,
+    /// Synthesized absolute touchpad position in the 0..=PAD_MOTION_MAX range.
+    pad_pos: (f64, f64),
 }
 
 impl XInputDriver {
@@ -35,10 +50,23 @@ impl XInputDriver {
         {
             return Err(format!("Device '{fmtpath}' is not a Legion Go S Controller").into());
         }
+        let pad_enabled = std::env::var(GAMEPAD_TOUCHPAD_ENV)
+            .map(|v| v != "0")
+            .unwrap_or(true);
+        let pad_gain = std::env::var(GAMEPAD_TOUCHPAD_GAIN_ENV)
+            .ok()
+            .and_then(|v| v.parse::<f64>().ok())
+            .filter(|g| g.is_finite() && *g > 0.0)
+            .unwrap_or(1.0);
+        log::debug!("Gamepad report touchpad enabled: {pad_enabled}, gain: {pad_gain}");
+
         Ok(Self {
             device,
             xinput_state: None,
             filtered_events: vec![],
+            pad_enabled,
+            pad_gain,
+            pad_pos: (PAD_MOTION_MAX / 2.0, PAD_MOTION_MAX / 2.0),
         })
     }
 
@@ -318,6 +346,66 @@ impl XInputDriver {
             );
         }
 
+        if self.pad_enabled {
+            self.translate_touchpad(&state, &old_state, &mut events);
+        }
+
         events
     }
+
+    /// Translate the touchpad fields of the gamepad report (touching flag,
+    /// tap/click flag and signed relative deltas) into absolute touchpad
+    /// events. Each touch starts at the pad center and the deltas move the
+    /// position, clamped to the pad range.
+    fn translate_touchpad(
+        &mut self,
+        state: &XInputDataReport,
+        old_state: &XInputDataReport,
+        events: &mut Vec<Event>,
+    ) {
+        let touching = state.rpad_touching;
+        let was_touching = old_state.rpad_touching;
+        let mut moved = false;
+
+        if touching {
+            if !was_touching {
+                self.pad_pos = (PAD_MOTION_MAX / 2.0, PAD_MOTION_MAX / 2.0);
+            }
+            let dx = state.touch_x as f64 * self.pad_gain;
+            let dy = state.touch_y as f64 * self.pad_gain;
+            if dx != 0.0 || dy != 0.0 {
+                self.pad_pos.0 = (self.pad_pos.0 + dx).clamp(0.0, PAD_MOTION_MAX);
+                self.pad_pos.1 = (self.pad_pos.1 + dy).clamp(0.0, PAD_MOTION_MAX);
+                moved = true;
+            }
+        }
+
+        if touching != was_touching || moved {
+            self.emit(
+                events,
+                Event::Axis(AxisEvent::Touchpad(TouchAxisInput {
+                    index: 0,
+                    is_touching: touching,
+                    x: self.pad_pos.0.round() as u16,
+                    y: self.pad_pos.1.round() as u16,
+                })),
+            );
+        }
+
+        if state.rpad_tap != old_state.rpad_tap {
+            self.emit(
+                events,
+                Event::Button(ButtonEvent::RPadPress(BinaryInput {
+                    pressed: state.rpad_tap,
+                })),
+            );
+            // The deck target needs a force value to produce a click.
+            self.emit(
+                events,
+                Event::Trigger(TriggerEvent::RpadForce(TriggerInput {
+                    value: PAD_FORCE_NORMAL * state.rpad_tap as u8,
+                })),
+            );
+        }
+    }
 }
diff --git a/src/input/source/hidraw/legion_go_s/xinput.rs b/src/input/source/hidraw/legion_go_s/xinput.rs
index f042bd1..46a7091 100644
--- a/src/input/source/hidraw/legion_go_s/xinput.rs
+++ b/src/input/source/hidraw/legion_go_s/xinput.rs
@@ -15,7 +15,10 @@ use crate::{
         steam_deck::hid_report::{CommandType, PackedTriggerHapticPulse, PadSide},
     },
     input::{
-        capability::{Capability, Gamepad, GamepadAxis, GamepadButton, GamepadTrigger},
+        capability::{
+            Capability, Gamepad, GamepadAxis, GamepadButton, GamepadTrigger, Touch, TouchButton,
+            Touchpad,
+        },
         event::native::NativeEvent,
         output_capability::{Haptic, OutputCapability},
         output_event::OutputEvent,
@@ -327,4 +330,7 @@ pub const CAPABILITIES: &[Capability] = &[
     Capability::Gamepad(Gamepad::Button(GamepadButton::West)),
     Capability::Gamepad(Gamepad::Trigger(GamepadTrigger::LeftTrigger)),
     Capability::Gamepad(Gamepad::Trigger(GamepadTrigger::RightTrigger)),
+    Capability::Gamepad(Gamepad::Trigger(GamepadTrigger::RightTouchpadForce)),
+    Capability::Touchpad(Touchpad::RightPad(Touch::Button(TouchButton::Press))),
+    Capability::Touchpad(Touchpad::RightPad(Touch::Motion)),
 ];
